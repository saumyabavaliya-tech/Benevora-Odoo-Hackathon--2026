# =================================================================
# GlobeTrotter Backend Environment Configuration
# =================================================================

# PostgreSQL Database Connection URL
# Syntax: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/globetrotter

# Optional: Set to True to print all generated SQL queries to console
DB_ECHO=False

# JWT Authentication
JWT_SECRET_KEY=globetrotter_hackathon_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend CORS Origin (Vite default dev server)
FRONTEND_ORIGIN=http://localhost:5173
